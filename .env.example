# Environment variable NAMES used by Network Monitor. No values belong in
# this file or anywhere in the repo (Standing Rule 5, CLAUDE.md / AGENTS.md).
# Set real values in each consumer's environment, or a secrets manager. A
# gitignored .env.local is read by Next.js only: export capture-agent and
# osi-inspect values in the shell that launches them. Coordination credentials
# belong in coordination/.env.
# Every variable is optional and commented out: an empty assignment (NAME=)
# overrides the code default (e.g. an empty AGENT_TOKEN_FILE breaks the relay),
# so uncomment only the ones you set. Defaults are in the code that reads them.

# Capture agent (capture-agent/src/main.rs)
# CAPTURE_INTERFACE=
# RELAY_PORT=
# FRONT_DOOR_PORT=
# MAX_FLOWS=
# MAX_OBSERVED_DNS_NAMES=
# FOLLOW_STREAM=
# REPLAY_FILE=
# REPLAY_SPEED=
# REPLAY_LOCAL_ADDRS=
# REPLAY_WAIT_FOR_IO_SERIES=

# Shared: path to the 0600 per-launch control-token file (default under ~/.network-monitor/)
# AGENT_TOKEN_FILE=

# Next.js relay / UI
# ALLOWED_HOSTS=
# DISABLE_HMR=

# osi-inspect (bin/osi-inspect.js)
# OSI_INSPECT_RELAY_URL=

# Coordination scripts. Real values go in coordination/.env (gitignored), never here.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_WEBHOOK_URL=
